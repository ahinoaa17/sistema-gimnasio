# ===== Cóndor Iron Gym · variables de entorno =====
# Copiar como .env y completar. NUNCA subir el .env real al repositorio.

# --- Base de datos en Amazon RDS (us-east-1) ---
DB_HOST=condor-gym-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=condor_gym
DB_SSL=true

# --- Seguridad ---
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=8h

# --- Servidor ---
PORT=3000
NODE_ENV=production
